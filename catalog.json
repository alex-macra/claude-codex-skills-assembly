{
  "schemaVersion": 1,
  "name": "ai-skills-assembly",
  "displayName": "AI Skills Assembly",
  "description": "AI Skills Assembly provides reusable cross-project skills, deterministic activation, safety hooks, and installers for Claude Code and OpenAI Codex.",
  "surfaces": {
    "skills": [
      "agents",
      "claude",
      "codex"
    ],
    "agents": [
      "claude"
    ],
    "outputStyles": [
      "claude"
    ]
  },
  "skills": {
    "adversarial-review": {
      "path": "skills/adversarial-review"
    },
    "architect-review": {
      "path": "skills/architect-review"
    },
    "delivery-loop": {
      "path": "skills/delivery-loop"
    },
    "fast-pr-workflow": {
      "path": "skills/fast-pr-workflow"
    },
    "orchestrator": {
      "path": "skills/orchestrator"
    },
    "post-merge-cleanup": {
      "path": "skills/post-merge-cleanup"
    },
    "qa-automation": {
      "path": "skills/qa-automation"
    },
    "security-review": {
      "path": "skills/security-review"
    },
    "see-it-live": {
      "path": "skills/see-it-live"
    },
    "task-research": {
      "path": "skills/task-research"
    },
    "web-dev": {
      "path": "skills/web-dev"
    }
  },
  "agents": {
    "cleaner": {
      "path": "agents/cleaner.md"
    },
    "orchestrator": {
      "path": "agents/orchestrator.md"
    },
    "reviewer": {
      "path": "agents/reviewer.md"
    }
  },
  "outputStyles": {
    "terse": {
      "path": "templates/output-styles/terse.md"
    }
  },
  "profiles": {
    "default": {
      "description": "Install the complete generic skill and agent set.",
      "skills": [
        "adversarial-review",
        "architect-review",
        "delivery-loop",
        "fast-pr-workflow",
        "orchestrator",
        "post-merge-cleanup",
        "qa-automation",
        "security-review",
        "see-it-live",
        "task-research",
        "web-dev"
      ],
      "agents": [
        "cleaner",
        "orchestrator",
        "reviewer"
      ],
      "outputStyles": [
        "terse"
      ]
    }
  },
  "globalRules": {
    "claude": "templates/CLAUDE.md",
    "codex": "templates/AGENTS.md"
  },
  "hooks": {
    "activation": "hooks/skill-activation.py",
    "usage": "hooks/skill-usage-log.py",
    "mergeGuard": "hooks/merge-guard.py"
  },
  "routing": {
    "registry": "routing/skill-rules.json",
    "fixtures": "routing/routing-expectations.json"
  }
}
