    "code-comments": {
      "type": "process",
      "priority": "medium",
      "description": "When and how to comment - default none, comment only the non-obvious WHY. Strips restatement, ticket refs, provenance notes, and verbose preambles.",
      "promptTriggers": {
        "keywords": [
          "comment",
          "comments",
          "commenting",
          "docstring",
          "doc comment",
          "jsdoc",
          "tsdoc",
          "block comment",
          "inline comment",
          "code comment",
          "uncomment",
          "commented out",
          "explain this code",
          "add a note",
          "document this function",
          "header comment"
        ],
        "intentPatterns": [
          "(add|write|remove|strip|clean up|reduce|trim).*?(comment|docstring|jsdoc|tsdoc)",
          "(too many|fewer|less|minimal|verbose).*?comment",
          "(should (i|we)|do (i|we) need).*?comment",
          "(document|annotate).*?(function|method|class|module|file)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": []
      }
    },
