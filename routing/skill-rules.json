{
  "version": "1.0",
  "description": "Activation triggers for the generic skills shipped by this catalog.",
  "skills": {
    "a11y-audit": {
      "type": "domain",
      "priority": "medium",
      "description": "Dedicated accessibility audit - axe/Lighthouse plus a WCAG 2.2 AA manual checklist, severity-ranked findings with fixes.",
      "promptTriggers": {
        "keywords": [
          "accessibility",
          "accessibility audit",
          "a11y",
          "a11y audit",
          "WCAG",
          "wcag audit",
          "screen reader",
          "VoiceOver",
          "NVDA",
          "axe-core",
          "axe scan",
          "lighthouse accessibility",
          "contrast ratio",
          "keyboard navigation"
        ],
        "intentPatterns": [
          "(run|do|perform|conduct).*?(a11y|accessibility|wcag).*?(audit|scan|review|check)",
          "(audit|scan|check|test).*?(a11y|accessibility|wcag|screen reader)",
          "(is (this|it)|are we).*?(accessible|wcag|a11y)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": []
      }
    },
    "adversarial-review": {
      "type": "process",
      "priority": "medium",
      "description": "Independent second-pass review that tries to break the change - edge cases, error paths, invariants, concurrency, security - ending in a verdict.",
      "promptTriggers": {
        "keywords": [
          "adversarial review",
          "adversarial",
          "red team",
          "red-team",
          "second opinion",
          "second-opinion",
          "try to break",
          "poke holes",
          "devil's advocate",
          "stress test this",
          "what could go wrong",
          "find the flaw",
          "attack this"
        ],
        "intentPatterns": [
          "(adversarial|red.?team|second.?opinion).*?(review|check|pass|look)",
          "(try to |attempt to )?(break|refute|falsify|poke holes in).*?(this|the|change|diff|code|assumption|logic)",
          "(what (could|can|would) go wrong|find the (bug|flaw|edge case|hole))"
        ]
      },
      "fileTriggers": {
        "pathPatterns": []
      }
    },
