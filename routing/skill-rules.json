    "delivery-loop": {
      "type": "process",
      "priority": "high",
      "description": "Bounded delivery conductor with one writer, durable pause and resume state, focused verification, ordered reviews, PR shipping, and remote-head verification.",
      "promptTriggers": {
        "keywords": [
          "delivery loop",
          "quality loop",
          "review loop",
          "plan to implementation",
          "plan-to-implementation",
          "verify fix rerun",
          "verify/fix/rerun",
          "PR readiness",
          "pr readiness",
          "ready for PR",
          "ready for pr",
          "run this through quality",
          "before PR",
          "before pr",
          "from planning to implementation",
          "work this in a loop",
          "run the orchestrator"
        ],
        "intentPatterns": [
          "(run|take|move).*?(through|from).*?(delivery|quality|review).*?(loop|gate|workflow)",
          "(work|run|take).*?(this|task|change|work).*?(in|through).*?(a )?loop",
          "(run|use|start).*?(orchestrator|conductor).*?(task|change|work|workflow)",
          "(plan|planning).*?(to|through).*?(implementation|implement)",
          "(plan|planning).*?(then|and).*?(implementation|implement|build)",
          "(plan|planning).*?(then|and|do).*?(quality|review|smoke)",
          "(verify|test|check).*?(fix|repair).*?(rerun|re-run|again)",
          "(review|adversarial review).*?(then|and).*?(smoke|smoke test)",
          "(quality|review|smoke|security|a11y|accessibility).*?(before|for).*?(PR|pr|pull request)",
          "(prepare|make|get).*?(ready).*?(PR|pr|pull request)",
          "^(please |let.?s )?(pause|stop).*?\\b(ongoing|current|this)\\b.*?\\b(work|task|loop)\\b",
          "^(please |let.?s )?(resume|continue).*?(\\b(task|work|loop)\\b|pull request|\\b(PR|pr)\\b)",
          "^(please |let.?s )?(use|run) (multiple|parallel) agents( in parallel)?",
          "^(please |let.?s )?work.*?(task|tasks|work|change|changes).*?with (multiple|parallel) agents"
        ]
      },
      "fileTriggers": {
        "pathPatterns": []
      }
